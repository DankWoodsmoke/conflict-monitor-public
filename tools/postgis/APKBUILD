# Private prototype derived from Alpine aports a9c3ba8b9129ec0f294d0a9bf538c2f1632bb016.
# This is locally built/signed; it is NOT an Alpine-supported security update.
maintainer="Private qualification <private-build@example.invalid>"
pkgname=sqlite
subpackages="$pkgname-static $pkgname-doc $pkgname-dev $pkgname-libs"
pkgver=3.54.1
pkgrel=0
pkgdesc="SQLite shared library - private Alpine-native upstream 3.54.1 prototype"
url="https://sqlite.org/"
arch="all"
license="blessing"
makedepends="build-base readline-dev"
source="sqlite-autoconf-3540100.tar.gz smoke.sql session_probe.c"
builddir="$srcdir/sqlite-autoconf-3540100"
_amalgamation="-DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_SECURE_DELETE -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_GEOPOLY -DSQLITE_USE_URI -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_SOUNDEX -DSQLITE_MAX_VARIABLE_NUMBER=250000"

build() {
    export CFLAGS="${CFLAGS//-Os/-O2} $_amalgamation"
    ./configure --build="$CBUILD" --host="$CHOST" --prefix=/usr \
        --enable-threadsafe --enable-readline \
        --with-readline-header=/usr/include/readline/readline.h \
        --enable-session --enable-static --enable-fts3 --enable-fts4 --enable-fts5 \
        --soname=legacy
    make -j2
}

check() {
    ./sqlite3 :memory: < "$srcdir/smoke.sql" > "$startdir/sqlite-smoke-output.txt"
    cat "$startdir/sqlite-smoke-output.txt"
    test "$(cat "$startdir/sqlite-smoke-output.txt")" = "3.54.1
1
1
ok"
    ln -sf libsqlite3.so libsqlite3.so.0
    cc -DSQLITE_ENABLE_SESSION -DSQLITE_ENABLE_PREUPDATE_HOOK \
        -I. "$srcdir/session_probe.c" -L. -Wl,-rpath,"$builddir" -lsqlite3 \
        -o "$startdir/session-probe"
    "$startdir/session-probe" > "$startdir/session-probe-output.txt"
    cat "$startdir/session-probe-output.txt"
    grep -q '^SESSION_ROUNDTRIP_OK 3.54.1 ' "$startdir/session-probe-output.txt"
}

package() {
    make DESTDIR="$pkgdir" install
}

