# Copy deliberately; never publish your .env or Telegram session.
POSTGRES_PASSWORD=
# Separate runtime secret: generate 32 random bytes as 64 hex characters.
# POSTGRES_PASSWORD belongs only to the database bootstrap/migration administrator.
POSTGRES_APP_PASSWORD=
DEMO_MODE=false
LIVE_INGESTION_ENABLED=false
RSS_PROCESSING_MODE=reports
RSS_RELEVANCE_MODE=keywords
# Empty selects the 31 default-eligible IDs in the fixed catalog. Collection is
# still disabled above. Use explicit comma-separated IDs for a smaller watchlist.
RSS_SOURCES=
RSS_POLL_INTERVAL_SECONDS=300
RSS_MAX_ITEMS_PER_FEED=20
RSS_MAX_INGEST_PER_CYCLE=60
# Measured fast report-only profile: selected_sources, 60 seconds, 5/feed, 200
# globally. It preserves selected posts, not just conflict-keyword matches.
# See docs/SOURCE_COLLECTION.md before changing cadence or source rights.
X_INGESTION_ENABLED=false
ENABLE_SITREP_GENERATION=false
ENABLE_VIDEO_GENERATION=false
# Optional free local tools. Install stock weights and a licensed voice first.
ENABLE_LOCAL_AI=false
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3.5:4b
LOCAL_AI_TIMEOUT_SECONDS=180
LOCAL_AI_NUM_GPU=0
BRIEFING_ARTIFACT_DIR=/app/videos/briefing
BRIEFING_MAX_AGE_HOURS=24
PIPER_MODEL_PATH=
PIPER_VOICE_DIR=./artifacts/private/piper-voice
ADMIN_API_KEY=
# Public, browser-restricted Google Maps key. Explicit opt-in; separate provider terms.
GOOGLE_EARTH_ENABLED=false
GOOGLE_MAPS_BROWSER_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=
# Explicit public channel usernames only; free reports do not expand to all sources.
TELEGRAM_CHANNELS=
TELEGRAM_PROCESSING_MODE=reports
TELEGRAM_STARTUP_MAX_MESSAGES=20
ANTHROPIC_API_KEY=
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
SITREP_MODEL=claude-sonnet-4-6
AISSTREAM_API_KEY=
TWITTER_BEARER_TOKEN=
FIRMS_MAP_KEY=
SENTINEL_HUB_INSTANCE_ID=
# Optional self-hosted or permitted geocoder, not automatic public-service bulk use.
NOMINATIM_URL=
