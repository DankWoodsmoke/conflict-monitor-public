+    return 0;
+  }
+
+  rv = nghttp2_session_update_recv_connection_window_size(session, datalen);
+  if (nghttp2_is_fatal(rv)) {
+    return rv;
+  }
+
+  if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+    return 0;
+  }
+
+  stream = nghttp2_session_get_stream(session, stream_id);
+  if (!stream) {
+    return 0;
