+
+  rv = nghttp2_session_update_recv_stream_window_size(
+    session, stream, datalen,
+    !(iframe->frame.hd.flags & NGHTTP2_FLAG_END_STREAM) &&
+      stream->state != NGHTTP2_STREAM_CLOSING);
+  if (nghttp2_is_fatal(rv)) {
+    return rv;
+  }
+
+  return 0;
