+static nghttp2_ssize
+block_count_fixed_bytes_send_callback(nghttp2_session *session,
+                                      const uint8_t *data, size_t len,
+                                      int flags, void *user_data) {
+  my_user_data *ud = user_data;
+  (void)session;
+  (void)data;
+  (void)flags;
+
+  if (ud->block_count == 0) {
+    return NGHTTP2_ERR_WOULDBLOCK;
+  }
