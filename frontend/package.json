  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.0",
    "vite": "8.3.5",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
